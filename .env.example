# ============================================================================
#  DedSilva / Kaynes Warehouse System: settings
#  Copy this file to ".env" (the VPS setup script does this for you) and fill it in.
#  Never share the .env file and never put it on GitHub. Restart after changes:
#      sudo systemctl restart dedsilva-wms
# ============================================================================

# ---- server ----------------------------------------------------------------
NODE_ENV=production
PORT=3000
# 127.0.0.1 = only Nginx on the same server can reach the app (recommended on a VPS)
HOST=127.0.0.1
# where the database and backups live (outside the app folder, so updates never touch your data)
DATA_DIR=
# long random text used to sign logins. The setup script fills this in. Changing it logs everyone out.
SECRET=751b1fbfd90d9c982c72c3f83f92a1ca9760754f031d67a06eb43ee19580de37d55457b536d5d93cdd05f912bd1d5ca66f1355824231e443a5b469e475088dab
# only if your reverse proxy is NOT on this server: number of proxy hops (usually 1)
#TRUST_PROXY=1

# ---- who receives the invoice-download codes -------------------------------
# Email: the code is emailed here (needs SMTP below). Use one address for both, or one per company.
COMPANY_EMAIL= makorijob760@gmail.com
#COMPANY_EMAIL_DS=makorijob760@gmail.com
#COMPANY_EMAIL_KW=sales@kaynesltd.com
# WhatsApp: the same code is also sent to this company WhatsApp number (international format, like +254712345678)
COMPANY_WHATSAPP=0700555565
#COMPANY_WHATSAPP_DS=0700555565
#COMPANY_WHATSAPP_KW=0700555565

# ---- EMAIL (Nodemailer / SMTP) ---------------------------------------------
# Any SMTP service works: Zoho, Google Workspace (use an App Password), Microsoft 365, Brevo, Mailgun, your hosting email...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true for port 465, false for 587
SMTP_SECURE=false
SMTP_USER=makorijob760@gmail.com
SMTP_PASS=tgzwbscolqmvnqgk
# shown as the sender, e.g.  Warehouse <no-reply@makorijob760@gmail.com>
SMTP_FROM="makorijob760@gmail.com"

# ---- SMS to the RECEIVER (delivery code) -----------------------------------
# africastalking (default, best for Kenya) or twilio
SMS_PROVIDER=africastalking
# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=atsk_16e1e270e0623489e3fec0e1cc3bb5053ee702b5114af489d596f6a0e98858659906986a
# optional approved sender name (alphanumeric sender ID), leave empty to use the shared one
AT_SENDER_ID=
# AT_USERNAME=sandbox and a sandbox key = test mode (messages are not delivered to real phones)
# Twilio (only if SMS_PROVIDER=twilio)
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_SMS_FROM=+1xxxxxxxxxx
#TWILIO_MESSAGING_SERVICE_SID=
# numbers typed without a country code (like 0712345678) get this one
DEFAULT_COUNTRY_CODE=254

# ---- WHATSAPP to the company (invoice-download code) -----------------------
# meta (WhatsApp Cloud API, default) or twilio
WHATSAPP_PROVIDER=meta
# Meta WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Name of your APPROVED message template (category "Authentication"). Needed to message the company at any time.
# Without a template, WhatsApp only delivers if the company number messaged your business number in the last 24 hours.
WA_TEMPLATE=
WA_TEMPLATE_LANG=en
# authentication templates have a "Copy code" button: keep true. Set false if your template has no button.
WA_TEMPLATE_BUTTON=true
# Twilio WhatsApp (only if WHATSAPP_PROVIDER=twilio)
#TWILIO_WHATSAPP_FROM=+14155238886
#TWILIO_WA_CONTENT_SID=

# ---- order updates to merchandisers ----------------------------------------
# A merchandiser is texted when their order is priced, dispatched and delivered (their phone is set on the Staff screen).
# sms (default) | whatsapp | both | off.   (WhatsApp here is plain text, so it only arrives inside Meta's 24-hour window: SMS is recommended.)
STATUS_NOTIFY=sms

# ---- daily summary email for managers --------------------------------------
# Orders taken/priced/dispatched/delivered today, unpaid and overdue invoices, low stock. Sent once a day after this hour.
DAILY_REPORT=on
DAILY_REPORT_HOUR=18
# who gets it (comma-separated list allowed). Blank = the company email above.
#REPORT_EMAIL_DS=manager@dedsilva.com,owner@dedsilva.com
#REPORT_EMAIL_KW=manager@kaynesltd.com
# time zone for "today" and the send hour
TZ=Africa/Nairobi

# ---- testing only (leave these OFF on the live server) ---------------------
# shows the delivery code on screen instead of hiding it from the rider
OTP_SHOW_ON_SCREEN=false
# writes message text (including codes) to the server log when a channel is not set up
NOTIFY_DEBUG_LOG=false


